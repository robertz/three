	// Generated once at startup and broadcast to every client in "welcome" so
	// every player sees the identical arrangement of trees/rocks/mountains —
	// these used to be independently randomized per-client in world.js (plain
	// unseeded Math.random(), no server involvement at all), so two players
	// standing in the "same" spot saw completely different scenery, and worse,
	// each client built its own different collision-obstacle list.
	private function _generateWorldLayout() {
		var propTypes = [ "tree_default", "tree_pineRoundA", "tree_oak", "tree_fat", "rock_largeA", "rock_largeC", "stump_round", "plant_bushDetailed" ]
		var mountainTypes = [ "rock_largeA", "rock_largeC" ]
		var propCount = 320
		var mountainCount = 84
		var propScatterRadius = variables.zones[ variables.zones.len() ].maxRadius
		var mountainHorizonRadius = variables.worldBounds + 40

		variables.props = []
		for ( var i = 1; i <= propCount; i++ ) {
			variables.props.append( {
				type: propTypes[ int( rand() * propTypes.len() ) + 1 ],
				x: ( rand() - 0.5 ) * 2 * propScatterRadius,
				z: ( rand() - 0.5 ) * 2 * propScatterRadius,
				rotationY: rand() * variables.javaMath.PI * 2
			} )
		}

		variables.mountains = []
		for ( var i = 1; i <= mountainCount; i++ ) {
			var mountainAngle = ( ( i - 1 ) / mountainCount ) * variables.javaMath.PI * 2 + ( ( rand() - 0.5 ) * 0.15 )
			var mountainRingRadius = mountainHorizonRadius + ( ( rand() - 0.5 ) * 20 )
			variables.mountains.append( {
				type: mountainTypes[ int( rand() * mountainTypes.len() ) + 1 ],
				x: variables.javaMath.cos( mountainAngle ) * mountainRingRadius,
				z: variables.javaMath.sin( mountainAngle ) * mountainRingRadius,
				rotationY: rand() * variables.javaMath.PI * 2,
				scale: 26 + ( rand() * 22 )
			} )
		}
	}

	function getMonsterTypes() { return variables.monsterTypes }
	function getZones() { return variables.zones }
	function getItemTypes() { return variables.itemTypes }
	function getSkillTypes() { return variables.skillTypes }
	function getEquipSlots() { return variables.equipSlots }
	function getNpcs() { return variables.npcs }
	function getShopRange() { return variables.shopRange }
	function getProps() { return variables.props }
	function getMountains() { return variables.mountains }

	function getWorldBounds() { return variables.worldBounds }
	function getWanderRadius() { return variables.wanderRadius }
	function getTickSeconds() { return variables.tickSeconds }
	function getPlayerRespawnDelay() { return variables.playerRespawnDelay }
	function getDeathXpPenalty() { return variables.deathXpPenalty }
	function getAttackRange() { return variables.attackRange }
	function getAttackCooldown() { return variables.attackCooldown }
	function getSaveIntervalSeconds() { return variables.saveIntervalSeconds }
	function getChatMaxLength() { return variables.chatMaxLength }
	function getHpRegenIntervalSeconds() { return variables.hpRegenIntervalSeconds }
	function getHpRegenPercent() { return variables.hpRegenPercent }
	function getMonsterVisibilityRadius() { return variables.monsterVisibilityRadius }

	// Resolves each npc's raw shopCatalog item keys (the source of truth
	// handleBuyItem validates against, see PlayerService) into the
	// display-ready shape the client's shop panel renders — same
	// key/name/price/equipSlot/rarity fields the old standalone
	// sendShopCatalog message used to send once globally, now carried per
	// merchant as part of the npc itself instead of a separate message.
	function npcSnapshot() {
		var list = []
		for ( var id in variables.npcs ) {
			var n = variables.npcs[ id ]
			var catalog = []
			for ( var key in n.shopCatalog ) {
				var t = variables.itemTypes[ key ]
				catalog.append( { key: key, name: t.name, price: t.price, equipSlot: t.equipSlot, rarity: t.rarity, usable: t.usable } )
			}
			list.append( { id: n.id, name: n.name, x: n.x, z: n.z, rotationY: n.rotationY, model: n.model, catalog: catalog } )
		}
		return list
	}

	function zoneSnapshot() {
		var list = []
		for ( var zone in variables.zones ) {
			list.append( { key: zone.key, name: zone.name, minRadius: zone.minRadius, maxRadius: zone.maxRadius, groundTint: zone.groundTint } )
		}
		return list
	}

}
