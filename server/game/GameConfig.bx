		variables.itemTypes[ "thornwoodCap" ] = { name: "Thornwood Cap", usable: false, healAmount: 0, equipSlot: "helmet", bonusAttackDamage: 0, bonusMaxHp: 38, price: 150, sellPrice: _commonSell( 150 ), rarity: "common" }
		variables.itemTypes[ "thornwoodJerkin" ] = { name: "Thornwood Jerkin", usable: false, healAmount: 0, equipSlot: "chest", bonusAttackDamage: 0, bonusMaxHp: 70, price: 260, sellPrice: _commonSell( 260 ), rarity: "common" }
