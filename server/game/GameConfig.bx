/**
 * Static world config + the one-time-generated world layout. No runtime
 * mutation — everything here is either a fixed constant or rolled once at
 * server startup (in init()) and handed out unchanged for the life of the
 * process. Player/monster live state lives in PlayerService/MonsterService
 * instead, not here.
 */
class {

	function init() {
		variables.javaMath = createObject( "java", "java.lang.Math" )

		variables.worldBounds = 99
		variables.wanderRadius = 6
		variables.tickSeconds = 0.2
		variables.playerRespawnDelay = 3
		variables.deathXpPenalty = 0.1
		variables.attackRange = 3
		variables.attackCooldown = 1
		variables.skillCooldown = 4
		variables.skillMultiplier = 2
		variables.saveIntervalSeconds = 5
		variables.chatMaxLength = 200

		// respawnDelay is seconds until a corpse can respawn — actual timing gets
		// +/-15% jitter (see MonsterService's handleAttack death handling) so a
		// cleared group doesn't all pop back in lockstep. Modeled on classic
		// WoW's outdoor respawns: common low-level critters are back in well
		// under a minute so questing/farming doesn't stall, tougher mobs take
		// noticeably longer.
		variables.monsterTypes = {
			boar: {
				name: "Boar", level: 1, hp: 30, damage: 0, xpReward: 10, goldMin: 5, goldMax: 15,
				aggressive: false, aggroRadius: 0, attackRange: 1.2, attackCooldown: 1.5, speed: 1.2, baseY: 0.6,
				dropItem: "apple", dropChance: 0.3, respawnDelay: 30
			},
			wolf: {
				name: "Wolf", level: 2, hp: 50, damage: 8, xpReward: 25, goldMin: 15, goldMax: 30,
				aggressive: true, aggroRadius: 8, attackRange: 1.6, attackCooldown: 1.5, speed: 2.6, baseY: 0.5,
				dropItem: "wolfFang", dropChance: 0.4, respawnDelay: 45
			},
			// Higher-level reskins of the same two models (see monsters.js's TINT map)
			// rather than new art — they only spawn in the Ashen Highlands zone.
			alphaBoar: {
				name: "Alpha Boar", level: 5, hp: 90, damage: 14, xpReward: 55, goldMin: 25, goldMax: 45,
				aggressive: true, aggroRadius: 7, attackRange: 1.4, attackCooldown: 1.3, speed: 1.8, baseY: 0.6,
				dropItem: "apple", dropChance: 0.4, respawnDelay: 90
			},
			direWolf: {
				name: "Dire Wolf", level: 7, hp: 140, damage: 20, xpReward: 90, goldMin: 40, goldMax: 70,
				aggressive: true, aggroRadius: 10, attackRange: 1.8, attackCooldown: 1.2, speed: 3.2, baseY: 0.5,
				dropItem: "wolfFang", dropChance: 0.5, respawnDelay: 120
			}
		}

		// Zones are just concentric bands of the one continuous world, keyed off
		// distance from the origin — no separate maps/instances, no loading
		// screens. Walking outward from spawn (where the shop sits) takes you
		// from the beginner Meadow into the tougher Highlands.
		variables.zones = [
			{ key: "meadow", name: "Sunfield Meadow", minRadius: 0, maxRadius: 45, spawns: { boar: 8, wolf: 4 } },
			{ key: "highlands", name: "Ashen Highlands", minRadius: 45, maxRadius: variables.worldBounds * 0.8, spawns: { alphaBoar: 5, direWolf: 5 } }
		]

		variables.itemTypes = {
			apple:         { name: "Apple",          usable: true,  healAmount: 20, equipSlot: "",        bonusAttackDamage: 0, bonusMaxHp: 0,  price: 5 },
			wolfFang:      { name: "Wolf Fang",      usable: false, healAmount: 0,  equipSlot: "",        bonusAttackDamage: 0, bonusMaxHp: 0,  price: 0 },
			ironSword:     { name: "Iron Sword",     usable: false, healAmount: 0,  equipSlot: "weapon",  bonusAttackDamage: 8, bonusMaxHp: 0,  price: 50 },
			leatherHelmet: { name: "Leather Helmet", usable: false, healAmount: 0,  equipSlot: "helmet",  bonusAttackDamage: 0, bonusMaxHp: 15, price: 30 },
			chainmailVest: { name: "Chainmail Vest", usable: false, healAmount: 0,  equipSlot: "chest",   bonusAttackDamage: 0, bonusMaxHp: 30, price: 60 },
			luckyCharm:    { name: "Lucky Charm",    usable: false, healAmount: 0,  equipSlot: "trinket", bonusAttackDamage: 3, bonusMaxHp: 10, price: 40 }
		}
		variables.equipSlots = [ "weapon", "helmet", "chest", "trinket" ]

		variables.npcs = { shopkeeper1: { id: "shopkeeper1", name: "Gilda the Vendor", x: 5, z: 5, rotationY: 0, model: "shopkeeper" } }
		variables.shopRange = 4
		variables.shopCatalog = [ "ironSword", "leatherHelmet", "chainmailVest", "luckyCharm", "apple" ]

		_generateWorldLayout()

		return this
	}

	// Generated once at startup and broadcast to every client in "welcome" so
	// every player sees the identical arrangement of trees/rocks/mountains —
	// these used to be independently randomized per-client in world.js (plain
	// unseeded Math.random(), no server involvement at all), so two players
	// standing in the "same" spot saw completely different scenery, and worse,
	// each client built its own different collision-obstacle list.
	private function _generateWorldLayout() {
		var propTypes = [ "tree_default", "tree_pineRoundA", "tree_oak", "tree_fat", "rock_largeA", "rock_largeC", "stump_round", "plant_bushDetailed" ]
		var mountainTypes = [ "rock_largeA", "rock_largeC" ]
		var propCount = 25
		var mountainCount = 36
		var propScatterRadius = 90
		var mountainHorizonRadius = 150

		variables.props = []
		for ( var i = 1; i <= propCount; i++ ) {
			variables.props.append( {
				type: propTypes[ int( rand() * propTypes.len() ) + 1 ],
				x: ( rand() - 0.5 ) * 2 * propScatterRadius,
				z: ( rand() - 0.5 ) * 2 * propScatterRadius,
				rotationY: rand() * variables.javaMath.PI * 2
			} )
		}

		variables.mountains = []
		for ( var i = 1; i <= mountainCount; i++ ) {
			var mountainAngle = ( ( i - 1 ) / mountainCount ) * variables.javaMath.PI * 2 + ( ( rand() - 0.5 ) * 0.15 )
			var mountainRingRadius = mountainHorizonRadius + ( ( rand() - 0.5 ) * 20 )
			variables.mountains.append( {
				type: mountainTypes[ int( rand() * mountainTypes.len() ) + 1 ],
				x: variables.javaMath.cos( mountainAngle ) * mountainRingRadius,
				z: variables.javaMath.sin( mountainAngle ) * mountainRingRadius,
				rotationY: rand() * variables.javaMath.PI * 2,
				scale: 26 + ( rand() * 22 )
			} )
		}
	}

	function getMonsterTypes() { return variables.monsterTypes }
	function getZones() { return variables.zones }
	function getItemTypes() { return variables.itemTypes }
	function getEquipSlots() { return variables.equipSlots }
	function getNpcs() { return variables.npcs }
	function getShopRange() { return variables.shopRange }
	function getShopCatalog() { return variables.shopCatalog }
	function getProps() { return variables.props }
	function getMountains() { return variables.mountains }

	function getWorldBounds() { return variables.worldBounds }
	function getWanderRadius() { return variables.wanderRadius }
	function getTickSeconds() { return variables.tickSeconds }
	function getPlayerRespawnDelay() { return variables.playerRespawnDelay }
	function getDeathXpPenalty() { return variables.deathXpPenalty }
	function getAttackRange() { return variables.attackRange }
	function getAttackCooldown() { return variables.attackCooldown }
	function getSkillCooldown() { return variables.skillCooldown }
	function getSkillMultiplier() { return variables.skillMultiplier }
	function getSaveIntervalSeconds() { return variables.saveIntervalSeconds }
	function getChatMaxLength() { return variables.chatMaxLength }

	function npcSnapshot() {
		var list = []
		for ( var id in variables.npcs ) {
			var n = variables.npcs[ id ]
			list.append( { id: n.id, name: n.name, x: n.x, z: n.z, rotationY: n.rotationY, model: n.model } )
		}
		return list
	}

	function zoneSnapshot() {
		var list = []
		for ( var zone in variables.zones ) {
			list.append( { key: zone.key, name: zone.name, minRadius: zone.minRadius, maxRadius: zone.maxRadius } )
		}
		return list
	}

}
