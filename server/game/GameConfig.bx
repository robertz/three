/**
 * Static world config + the one-time-generated world layout. No runtime
 * mutation — everything here is either a fixed constant or rolled once at
 * server startup (in init()) and handed out unchanged for the life of the
 * process. Player/monster live state lives in PlayerService/MonsterService
 * instead, not here.
 */
class {

	function init() {
		variables.javaMath = createObject( "java", "java.lang.Math" )

		variables.worldBounds = 430
		variables.wanderRadius = 6
		variables.tickSeconds = 0.2
		variables.playerRespawnDelay = 3
		variables.deathXpPenalty = 0.1
		variables.attackRange = 3
		variables.attackCooldown = 1
		variables.saveIntervalSeconds = 5
		variables.chatMaxLength = 200
		variables.hpRegenIntervalSeconds = 2
		variables.hpRegenPercent = 0.03

		// How far a monster has to be from EVERY connected player before
		// MonsterService's tick stops processing it at all (no wander, no
		// aggro scan, no respawn check) and it drops out of the broadcast
		// snapshot entirely. With 8 zones spread across a world this size,
		// most monsters at any moment are nowhere near a player — this
		// keeps the per-tick cost bounded by what's actually on screen
		// somewhere instead of the size of the whole world. Comfortably
		// bigger than any monster's aggroRadius * 1.5 chase leash (the
		// biggest is 14 * 1.5 = 21, see zone 8 below) so an active chase
		// never gets frozen mid-leash for going "out of range".
		variables.monsterVisibilityRadius = 140

		variables.itemTypes = {}
		variables.monsterTypes = {}
		variables.skillTypes = {}
		variables.zones = []
		variables.npcs = {}

		_buildSkills()
		_buildApple()
		_buildWolfFang()
		_buildMeadow()
		_buildHighlands()
		_buildThornwood()
		_buildFrostspire()
		_buildCinderWastes()
		_buildBlightmire()
		_buildShadowfen()
		_buildDragonsMaw()

		variables.equipSlots = [ "weapon", "helmet", "chest", "trinket" ]
		variables.shopRange = 4

		_generateWorldLayout()

		return this
	}

	// ── Abilities ────────────────────────────────────────────────────────────
	// Each unlocks at a level chosen against grantXp()'s curve in
	// PlayerService.bx (+3 atk/+20 hp per level, 1.3x XP escalation) — level
	// 20 is a real mid-game target, not an effectively-unreachable capstone.
	// Independent cooldowns (no shared "GCD"): using one doesn't block
	// another. Only the fields each effect type actually reads are set —
	// e.g. "cleave" has no executeThreshold, "selfBuff" has no multiplier.

	private function _buildSkills() {
		variables.skillTypes[ "heroicStrike" ] = {
			name: "Heroic Strike", levelRequired: 1, cooldown: 4, effect: "singleTarget", multiplier: 2
		}
		variables.skillTypes[ "cleave" ] = {
			name: "Cleave", levelRequired: 5, cooldown: 6, effect: "cleave", multiplier: 1
		}
		variables.skillTypes[ "execute" ] = {
			name: "Execute", levelRequired: 12, cooldown: 8, effect: "execute", multiplier: 4, executeThreshold: 0.25
		}
		variables.skillTypes[ "rampage" ] = {
			name: "Rampage", levelRequired: 20, cooldown: 25, effect: "selfBuff", buffMultiplier: 1.5, buffDuration: 8
		}
	}

	// ── Shared drops ─────────────────────────────────────────────────────────
	// Every boar-type across all 8 zones drops the same apple, and every
	// wolf-type drops the same wolf fang — they're vendor trash/healing,
	// not part of the zone's gear-progression identity, so there's no
	// reason for each zone to reinvent one. The gear (below) is what
	// actually differentiates a zone's reward.

	private function _buildApple() {
		variables.itemTypes[ "apple" ] = {
			name: "Apple", usable: true, healAmount: 20, equipSlot: "", bonusAttackDamage: 0, bonusMaxHp: 0,
			price: 5, sellPrice: 2, rarity: "common"
		}
	}

	private function _buildWolfFang() {
		variables.itemTypes[ "wolfFang" ] = {
			name: "Wolf Fang", usable: false, healAmount: 0, equipSlot: "", bonusAttackDamage: 0, bonusMaxHp: 0,
			price: 0, sellPrice: 3, rarity: "common"
		}
	}

	// sellPrice formulas for zone-3-and-up gear (zones 1-2 keep their
	// original hand-set prices unchanged, see below) — not a precise
	// science, just keeps a purchasable item worth roughly 40% of its
	// price back, and a rare (never purchasable) worth something
	// proportional to how strong it is.
	private function _commonSell( price ) {
		return round( price * 0.4 )
	}

	private function _rareSell( bonusAttackDamage, bonusMaxHp ) {
		return round( ( bonusAttackDamage * 3 ) + ( bonusMaxHp * 1.6 ) )
	}

	// Adds a zone's two monster types (a passive boar-type and an
	// aggressive wolf-type), its band of the map, and its merchant — every
	// _build*() below calls this last with its own numbers. zoneIndex is
	// 1-based and purely positional (npc placement angle, tier flavor);
	// it's NOT persisted anywhere a save file/client could depend on it
	// surviving a reorder.
	private function _registerZone(
		zoneIndex, key, name, minRadius, maxRadius, groundTint,
		boarKey, boarName, boarHp, boarDmg, boarXp, boarGoldMin, boarGoldMax, boarRespawn, boarSpawns, boarDrops,
		wolfKey, wolfName, wolfHp, wolfDmg, wolfXp, wolfGoldMin, wolfGoldMax, wolfRespawn, wolfSpawns, wolfDrops,
		wolfAggroRadius, wolfSpeed, wolfAttackRange, wolfAttackCooldown,
		merchantId, merchantName, shopCatalog
	) {
		variables.monsterTypes[ boarKey ] = {
			name: boarName, level: zoneIndex * 2 - 1, hp: boarHp, damage: boarDmg,
			xpReward: boarXp, goldMin: boarGoldMin, goldMax: boarGoldMax,
			aggressive: false, aggroRadius: 0, attackRange: 1.2, attackCooldown: 1.5, speed: 1.2, baseY: 0.6,
			drops: boarDrops, respawnDelay: boarRespawn
		}

		variables.monsterTypes[ wolfKey ] = {
			name: wolfName, level: zoneIndex * 2, hp: wolfHp, damage: wolfDmg,
			xpReward: wolfXp, goldMin: wolfGoldMin, goldMax: wolfGoldMax,
			aggressive: true, aggroRadius: wolfAggroRadius, attackRange: wolfAttackRange, attackCooldown: wolfAttackCooldown,
			speed: wolfSpeed, baseY: 0.5, drops: wolfDrops, respawnDelay: wolfRespawn
		}

		variables.zones.append( {
			key: key, name: name, minRadius: minRadius, maxRadius: maxRadius, groundTint: groundTint,
			spawns: {}
		} )
		variables.zones[ variables.zones.len() ].spawns[ boarKey ] = boarSpawns
		variables.zones[ variables.zones.len() ].spawns[ wolfKey ] = wolfSpawns

		// Merchants ring the origin at a golden-angle spread (~137.5° apart)
		// so they land at different bearings from spawn instead of all
		// lining up due north — zone 1 keeps its original literal position
		// (see _buildMeadow) rather than going through this formula.
		var midRadius = ( minRadius + maxRadius ) / 2
		var angle = ( zoneIndex - 1 ) * 2.4
		var npcX = variables.javaMath.cos( angle ) * midRadius
		var npcZ = variables.javaMath.sin( angle ) * midRadius
		variables.npcs[ merchantId ] = {
			id: merchantId, name: merchantName, x: npcX, z: npcZ,
			rotationY: variables.javaMath.atan2( -npcX, -npcZ ), model: "shopkeeper",
			shopCatalog: shopCatalog
		}
	}

	// ── Zone 1: Sunfield Meadow (level 1) ───────────────────────────────────
	// The original two monster types and the original single shop, left
	// numerically untouched — MonsterServiceSpec's "three hits kill a
	// boar at attackDamage 10" math depends on boar.hp staying exactly 30.

	private function _buildMeadow() {
		variables.itemTypes[ "ironSword" ] = { name: "Iron Sword", usable: false, healAmount: 0, equipSlot: "weapon", bonusAttackDamage: 8, bonusMaxHp: 0, price: 50, sellPrice: 20, rarity: "common" }
		variables.itemTypes[ "leatherHelmet" ] = { name: "Leather Helmet", usable: false, healAmount: 0, equipSlot: "helmet", bonusAttackDamage: 0, bonusMaxHp: 15, price: 30, sellPrice: 12, rarity: "common" }
		variables.itemTypes[ "chainmailVest" ] = { name: "Chainmail Vest", usable: false, healAmount: 0, equipSlot: "chest", bonusAttackDamage: 0, bonusMaxHp: 30, price: 60, sellPrice: 25, rarity: "common" }
		variables.itemTypes[ "luckyCharm" ] = { name: "Lucky Charm", usable: false, healAmount: 0, equipSlot: "trinket", bonusAttackDamage: 3, bonusMaxHp: 10, price: 40, sellPrice: 16, rarity: "common" }

		_registerZone(
			1, "meadow", "Sunfield Meadow", 0, 40, inputBaseN( "ffffff", 16 ),
			"boar", "Boar", 30, 0, 10, 5, 15, 30, 8, [ { item: "apple", chance: 0.3 } ],
			"wolf", "Wolf", 50, 8, 25, 15, 30, 45, 4, [ { item: "wolfFang", chance: 0.4 } ],
			8, 2.6, 1.6, 1.5,
			"shopkeeper1", "Gilda the Vendor",
			[ "ironSword", "leatherHelmet", "chainmailVest", "luckyCharm", "apple" ]
		)
	}

	// ── Zone 2: Ashen Highlands (level 5) ───────────────────────────────────
	// alphaBoar/direWolf are reskins of the Meadow's own pig/wolf models
	// (see client monsters.js's TINT map) — no new art, just tougher
	// stats. Rare drops here (steelSword/ironHelmet/plateArmor/ashenAmulet)
	// and their sell prices are the original hand-set values, unchanged.

	private function _buildHighlands() {
		variables.itemTypes[ "steelSword" ] = { name: "Steel Sword", usable: false, healAmount: 0, equipSlot: "weapon", bonusAttackDamage: 16, bonusMaxHp: 0, price: 0, sellPrice: 60, rarity: "rare" }
		variables.itemTypes[ "ironHelmet" ] = { name: "Iron Helmet", usable: false, healAmount: 0, equipSlot: "helmet", bonusAttackDamage: 0, bonusMaxHp: 30, price: 0, sellPrice: 60, rarity: "rare" }
		variables.itemTypes[ "plateArmor" ] = { name: "Plate Armor", usable: false, healAmount: 0, equipSlot: "chest", bonusAttackDamage: 0, bonusMaxHp: 55, price: 0, sellPrice: 100, rarity: "rare" }
		variables.itemTypes[ "ashenAmulet" ] = { name: "Ashen Amulet", usable: false, healAmount: 0, equipSlot: "trinket", bonusAttackDamage: 6, bonusMaxHp: 20, price: 0, sellPrice: 70, rarity: "rare" }

		variables.itemTypes[ "ashenBlade" ] = { name: "Ashen Blade", usable: false, healAmount: 0, equipSlot: "weapon", bonusAttackDamage: 14, bonusMaxHp: 0, price: 130, sellPrice: _commonSell( 130 ), rarity: "common" }
		variables.itemTypes[ "ashenCap" ] = { name: "Ashen Cap", usable: false, healAmount: 0, equipSlot: "helmet", bonusAttackDamage: 0, bonusMaxHp: 26, price: 90, sellPrice: _commonSell( 90 ), rarity: "common" }
		variables.itemTypes[ "ashenHauberk" ] = { name: "Ashen Hauberk", usable: false, healAmount: 0, equipSlot: "chest", bonusAttackDamage: 0, bonusMaxHp: 48, price: 160, sellPrice: _commonSell( 160 ), rarity: "common" }
		variables.itemTypes[ "ashenCharm" ] = { name: "Ashen Charm", usable: false, healAmount: 0, equipSlot: "trinket", bonusAttackDamage: 5, bonusMaxHp: 18, price: 110, sellPrice: _commonSell( 110 ), rarity: "common" }

		_registerZone(
			2, "highlands", "Ashen Highlands", 40, 75, inputBaseN( "aea27f", 16 ),
			"alphaBoar", "Alpha Boar", 90, 14, 55, 25, 45, 90, 5,
			[ { item: "apple", chance: 0.4 }, { item: "steelSword", chance: 0.12 }, { item: "ironHelmet", chance: 0.12 } ],
			"direWolf", "Dire Wolf", 140, 20, 90, 40, 70, 120, 5,
			[ { item: "wolfFang", chance: 0.5 }, { item: "plateArmor", chance: 0.12 }, { item: "ashenAmulet", chance: 0.12 } ],
			10, 3.2, 1.8, 1.2,
			"merchant_highlands", "Borin Ashcart",
			[ "ashenBlade", "ashenCap", "ashenHauberk", "ashenCharm", "apple" ]
		)
	}

