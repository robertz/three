/**
 * Game server entry point. Run with:
 *   ./start.sh
 * Requires the "three" MySQL database (see db/schema.sql) and the
 * datasource configured in boxlang.json.
 *
 * This file is a thin composition root — it wires services together and
 * defines the HTTP/WS transport glue. Game logic lives in server/game/
 * (GameConfig = static world data, PlayerService = live player state and
 * messaging, MonsterService = live monster state and combat/AI), account
 * REST routes live in server/routes/AccountRoutes.bx, and DB-only CRUD
 * lives in server/models/*.bx.
 */
app = boxExpress()

authService = new models.AuthService()
characterService = new models.CharacterService()
inventoryService = new models.InventoryService()
equipmentService = new models.EquipmentService()

gameConfig = new game.GameConfig()
playerService = new game.PlayerService( authService, characterService, inventoryService, equipmentService, gameConfig )
monsterService = new game.MonsterService( gameConfig, playerService )

accountRoutes = new routes.AccountRoutes( authService, characterService )

app.use( boxExpressCors( { origin: "http://localhost:5173", credentials: true } ) )
app.use( boxExpressJSON() )
app.use( boxExpressStatic( expandPath( "../client/dist" ) ) )

app.get( "/health", ( req, res ) => {
	res.json( { ok: true } )
} )

app.use( "/api", accountRoutes.getRouter() )

// ── Initial monster population ──────────────────────────────────────────────

for ( zone in gameConfig.getZones() ) {
	for ( typeKey in zone.spawns ) {
		for ( i = 1; i <= zone.spawns[ typeKey ]; i++ ) {
			monsterService.spawnMonster( typeKey, zone )
		}
	}
}

app.schedule( gameConfig.getTickSeconds() * 1000, () => {
	playerService.tickPlayerRespawns()
	monsterService.tickMonsterAI()
	playerService.broadcastAll( { type: "monsters", list: monsterService.monsterSnapshot() } )
} )

// ── Real-time player sync ───────────────────────────────────────────────

app.ws( "/game", ( connection ) => {
	var info = authService.sessionInfo( connection.cookies.session ?: "" )
	if ( !info.accountId || !info.characterId ) {
		connection.close()
		return
	}

	var playerId = playerService.connect( connection, info.accountId, info.characterId )

	connection.send( {
		type: "welcome", id: playerId, players: playerService.otherPlayers( playerId ),
		monsters: monsterService.monsterSnapshot(), npcs: gameConfig.npcSnapshot(), zones: gameConfig.zoneSnapshot(),
		props: gameConfig.getProps(), mountains: gameConfig.getMountains()
	} )
	var startPos = playerService.getPlayers()[ playerId ]
	playerService.broadcastExcept( playerId, { type: "join", id: playerId, x: startPos.x, z: startPos.z, rotationY: startPos.rotationY } )
	// The client's initial player object comes from the REST character-select
	// response, which is always the BASE (pre-equipment) stats — push the
	// recomputed effective stats now so gear equipped in a previous session
	// is reflected immediately rather than only after the next equip/level-up.
	playerService.sendStats( playerId )
	playerService.sendInventory( playerId )
	playerService.sendEquipment( playerId )
	playerService.sendShopCatalog( playerId )

	connection.onMessage( ( text ) => {
		var data = JSONDeserialize( text )
		var p = playerService.getPlayers()[ playerId ]

		if ( data.type == "chat" ) {
			playerService.handleChat( playerId, data.text )
			return
		}

		if ( p.respawning ) {
			return
		}

		if ( data.type == "move" ) {
			playerService.handleMove( playerId, data.x, data.z, data.rotationY )
		} else if ( data.type == "attack" ) {
			monsterService.handleAttack( playerId, data.targetId, false )
		} else if ( data.type == "skill" ) {
			monsterService.handleAttack( playerId, data.targetId, true )
		} else if ( data.type == "useItem" ) {
			playerService.handleUseItem( playerId, data.itemKey )
		} else if ( data.type == "equipItem" ) {
			playerService.handleEquipItem( playerId, data.itemKey )
		} else if ( data.type == "unequipItem" ) {
			playerService.handleUnequipItem( playerId, data.slot )
		} else if ( data.type == "buyItem" ) {
			playerService.handleBuyItem( playerId, data.itemKey )
		} else if ( data.type == "sellItem" ) {
			playerService.handleSellItem( playerId, data.itemKey )
		}

		playerService.maybeAutosave( playerId )
	} )

	connection.onClose( ( code, reason ) => {
		playerService.disconnect( playerId )
	} )
} )

app.use( ( err, req, res, next ) => {
	writeLog( text = "Unhandled error: " & err.message, log = "application" )
	res.status( 500 ).json( { error: true, message: err.message } )
} )

app.listen( 3001, ( port ) => {
	println( "Game server listening on http://localhost:#port#" )
} )
