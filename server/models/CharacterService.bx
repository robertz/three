/**
 * Loads/saves character rows. Each account may have up to MAX_CHARACTERS
 * named characters, selected via a character-select screen after login
 * (see AuthService's setSessionCharacter/sessionInfo) rather than one
 * auto-created row per account.
 */
class {

	MAX_CHARACTERS = 3;

	function list( accountId ) {
		var rows = queryExecute(
			"SELECT id, name, level FROM characters WHERE account_id = :accountId ORDER BY id",
			{ accountId: arguments.accountId }
		);
		var result = [];
		for ( var i = 1; i <= rows.recordCount; i++ ) {
			result.append( { id: rows.id[ i ], name: rows.name[ i ], level: rows.level[ i ] } );
		}
		return result;
	}

	function create( accountId, name ) {
		var cleanName = trim( arguments.name );
		if ( !len( cleanName ) || len( cleanName ) > 30 ) {
			throw( type = "InvalidCharacterName", message = "Character name must be 1-30 characters." );
		}
		if ( list( arguments.accountId ).len() >= MAX_CHARACTERS ) {
			throw( type = "CharacterLimitReached", message = "You already have the maximum number of characters." );
		}

		try {
			queryExecute(
				"INSERT INTO characters (account_id, name) VALUES (:accountId, :name)",
				{ accountId: arguments.accountId, name: cleanName },
				{ result: "local.insertResult" }
			);
		} catch ( database e ) {
			if ( findNoCase( "Duplicate entry", e.message & " " & ( e.detail ?: "" ) ) ) {
				throw( type = "CharacterNameTaken", message = "You already have a character with that name." );
			}
			rethrow;
		}

		return local.insertResult.generatedKey;
	}

	function ownedBy( characterId, accountId ) {
		var rows = queryExecute(
			"SELECT id FROM characters WHERE id = :characterId AND account_id = :accountId",
			{ characterId: arguments.characterId, accountId: arguments.accountId }
		);
		return rows.recordCount > 0;
	}

	function remove( characterId, accountId ) {
		queryExecute(
			"DELETE FROM characters WHERE id = :characterId AND account_id = :accountId",
			{ characterId: arguments.characterId, accountId: arguments.accountId }
		);
	}

	function load( characterId ) {
		var rows = queryExecute(
			"SELECT id, account_id, name, x, z, rotation_y, level, hp, max_hp, xp, xp_to_next, attack_damage, gold
			 FROM characters WHERE id = :characterId",
			{ characterId: arguments.characterId }
		);
		if ( rows.recordCount == 0 ) {
			throw( type = "CharacterNotFound", message = "Character not found." );
		}
		return {
			id: rows.id[ 1 ],
			accountId: rows.account_id[ 1 ],
			name: rows.name[ 1 ],
			x: rows.x[ 1 ],
			z: rows.z[ 1 ],
			rotationY: rows.rotation_y[ 1 ],
			level: rows.level[ 1 ],
			hp: rows.hp[ 1 ],
			maxHp: rows.max_hp[ 1 ],
			xp: rows.xp[ 1 ],
			xpToNext: rows.xp_to_next[ 1 ],
			attackDamage: rows.attack_damage[ 1 ],
			gold: rows.gold[ 1 ]
		};
	}

	function save( characterId, state ) {
		queryExecute(
			"UPDATE characters SET
				x = :x, z = :z, rotation_y = :rotationY, level = :level, hp = :hp,
				max_hp = :maxHp, xp = :xp, xp_to_next = :xpToNext,
				attack_damage = :attackDamage, gold = :gold
			 WHERE id = :characterId",
			{
				x: arguments.state.x, z: arguments.state.z, rotationY: arguments.state.rotationY,
				level: arguments.state.level, hp: arguments.state.hp, maxHp: arguments.state.maxHp,
				xp: arguments.state.xp, xpToNext: arguments.state.xpToNext,
				attackDamage: arguments.state.attackDamage, gold: arguments.state.gold,
				characterId: arguments.characterId
			}
		);
	}

}
