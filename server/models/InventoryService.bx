/**
 * Per-character item storage. Quantities only — no item instances/uniques,
 * just a stackable count per item key. Equipped items are moved out of
 * here into the `equipment` table (see EquipmentService) rather than
 * having a separate "equipped" flag on a row here.
 */
class {

	function addItem( characterId, itemKey, quantity = 1 ) {
		queryExecute(
			"INSERT INTO inventory_items (character_id, item_key, quantity)
			 VALUES (:characterId, :itemKey, :quantity)
			 ON DUPLICATE KEY UPDATE quantity = quantity + :quantity",
			{ characterId: arguments.characterId, itemKey: arguments.itemKey, quantity: arguments.quantity }
		);
	}

	function removeItem( characterId, itemKey, quantity = 1 ) {
		queryExecute(
			"UPDATE inventory_items SET quantity = quantity - :quantity
			 WHERE character_id = :characterId AND item_key = :itemKey AND quantity >= :quantity",
			{ characterId: arguments.characterId, itemKey: arguments.itemKey, quantity: arguments.quantity }
		);
		queryExecute(
			"DELETE FROM inventory_items WHERE character_id = :characterId AND quantity <= 0",
			{ characterId: arguments.characterId }
		);
	}

	function hasItem( characterId, itemKey, quantity = 1 ) {
		var rows = queryExecute(
			"SELECT quantity FROM inventory_items WHERE character_id = :characterId AND item_key = :itemKey",
			{ characterId: arguments.characterId, itemKey: arguments.itemKey }
		);
		return rows.recordCount > 0 && rows.quantity[ 1 ] >= arguments.quantity;
	}

	function list( characterId ) {
		var rows = queryExecute(
			"SELECT item_key, quantity FROM inventory_items WHERE character_id = :characterId AND quantity > 0",
			{ characterId: arguments.characterId }
		);
		var items = [];
		for ( var i = 1; i <= rows.recordCount; i++ ) {
			items.append( { key: rows.item_key[ i ], quantity: rows.quantity[ i ] } );
		}
		return items;
	}

}
