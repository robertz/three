/**
 * MonsterService depends on a real PlayerService (for reward/cooldown
 * effects), which in turn round-trips through the real "three" database —
 * see PlayerServiceSpec's header for why that's not mocked out. Each test
 * gets its own throwaway account+character, cleaned up afterEach.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.authService = new models.AuthService()
		variables.characterService = new models.CharacterService()
		variables.inventoryService = new models.InventoryService()
		variables.equipmentService = new models.EquipmentService()
		variables.gameConfig = new game.GameConfig()
		variables.javaMath = createObject( "java", "java.lang.Math" )
	}

	function run() {
		describe( "MonsterService", function() {

			beforeEach( function() {
				variables.playerService = new game.PlayerService(
					variables.authService, variables.characterService,
					variables.inventoryService, variables.equipmentService, variables.gameConfig
				)
				variables.monsterService = new game.MonsterService( variables.gameConfig, variables.playerService )
				variables.accountId = variables.authService.register( "spec_monster_" & createUUID(), "testpass123" )
				variables.characterId = variables.characterService.create( variables.accountId, "SpecFighter" )
				variables.fakeConnection = {
					send: ( payload ) => {},
					isClosed: () => false,
					close: () => {}
				}
				variables.playerId = variables.playerService.connect( variables.fakeConnection, variables.accountId, variables.characterId )
			} )

			afterEach( function() {
				queryExecute( "DELETE FROM accounts WHERE id = :id", { id: variables.accountId } )
			} )

			it( "spawnMonster places a monster within its zone's radius band with type-derived stats", function() {
				var zone = variables.gameConfig.getZones()[ 1 ] // meadow: 0-45
				variables.monsterService.spawnMonster( "boar", zone )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]

				var dist = variables.javaMath.sqrt( ( m.x * m.x ) + ( m.z * m.z ) )
				expect( dist ).toBeGTE( zone.minRadius )
				expect( dist ).toBeLTE( zone.maxRadius )
				expect( m.type ).toBe( "boar" )
				expect( m.hp ).toBe( variables.gameConfig.getMonsterTypes().boar.hp )
				expect( m.alive ).toBeTrue()
			} )

			it( "monsterSnapshot formats each monster into the wire shape clients expect", function() {
				variables.monsterService.spawnMonster( "wolf", variables.gameConfig.getZones()[ 1 ] )
				var snapshot = variables.monsterService.monsterSnapshot()

				expect( snapshot.len() ).toBe( 1 )
				expect( snapshot[ 1 ] ).toHaveKey( "id" )
				expect( snapshot[ 1 ] ).toHaveKey( "hp" )
				expect( snapshot[ 1 ] ).toHaveKey( "alive" )
				expect( snapshot[ 1 ].type ).toBe( "wolf" )
			} )

			it( "handleAttack damages a monster directly in front of the player, within range", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1 // rotationY=0 -> forward is +z, so this is in front
				p.rotationY = 0
				var hpBefore = m.hp

				variables.monsterService.handleAttack( variables.playerId, monsterId )

				expect( m.hp ).toBeLT( hpBefore )
			} )

			it( "handleAttack does nothing to a monster directly behind the player", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z + 1 // behind the player, given rotationY=0 -> forward=+z
				p.rotationY = 0
				var hpBefore = m.hp

				variables.monsterService.handleAttack( variables.playerId, monsterId )

				expect( m.hp ).toBe( hpBefore )
			} )

			it( "handleAttack does nothing to a monster outside attack range even if it's in front", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 500
				p.rotationY = 0
				var hpBefore = m.hp

				variables.monsterService.handleAttack( variables.playerId, monsterId )

				expect( m.hp ).toBe( hpBefore )
			} )

			it( "handleAttack respects the attack cooldown — a second immediate attack doesn't double-hit", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0

				variables.monsterService.handleAttack( variables.playerId, monsterId )
				var hpAfterFirst = m.hp
				variables.monsterService.handleAttack( variables.playerId, monsterId ) // still on cooldown

				expect( m.hp ).toBe( hpAfterFirst )
			} )

			it( "killing a monster grants xp/gold and marks it dead with a future respawn time", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0
				var xpBefore = p.xp
				var goldBefore = p.gold

				// attackDamage=10, boar hp=30 — three full hits kill it; bypass the
				// cooldown between them since this test is about the kill outcome,
				// not cooldown pacing (that's covered separately above).
				for ( var i = 1; i <= 3; i++ ) {
					variables.monsterService.handleAttack( variables.playerId, monsterId )
					p.attackReadyAt = 0
				}

				expect( m.alive ).toBeFalse()
				expect( m.hp ).toBe( 0 )
				expect( m.respawnAt ).toBeGT( 0 )
				expect( p.xp ).toBeGT( xpBefore )
				expect( p.gold ).toBeGT( goldBefore )
			} )

			it( "handleUseSkill rejects a skill the caster's level is too low for", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0
				var hpBefore = m.hp

				// A fresh character is level 1 — cleave requires level 5.
				variables.monsterService.handleUseSkill( variables.playerId, "cleave", monsterId )

				expect( m.hp ).toBe( hpBefore )
			} )

			it( "handleUseSkill heroicStrike deals double the caster's attack damage", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0
				var hpBefore = m.hp
				var atk = p.attackDamage

				variables.monsterService.handleUseSkill( variables.playerId, "heroicStrike", monsterId )

				expect( m.hp ).toBe( hpBefore - ( atk * 2 ) )
			} )

			it( "handleUseSkill cleave damages every alive monster in range and facing, leaving one behind the caster untouched", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				// Fresh MonsterService per test (see beforeEach) — ids are
				// deterministic (m1/m2/m3) rather than relying on
				// structKeyList()'s enumeration order for three entries.
				var inRange1 = monsters[ "m1" ]
				var inRange2 = monsters[ "m2" ]
				var behind = monsters[ "m3" ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.level = 5
				p.x = 0
				p.z = 0
				p.rotationY = 0 // forward is +z

				inRange1.x = 0
				inRange1.z = 1
				inRange2.x = 0.5
				inRange2.z = 1.5
				behind.x = 0
				behind.z = -5

				var hpBefore1 = inRange1.hp
				var hpBefore2 = inRange2.hp
				var hpBeforeBehind = behind.hp

				variables.monsterService.handleUseSkill( variables.playerId, "cleave", "" )

				expect( inRange1.hp ).toBeLT( hpBefore1 )
				expect( inRange2.hp ).toBeLT( hpBefore2 )
				expect( behind.hp ).toBe( hpBeforeBehind )
			} )

			it( "handleUseSkill execute is rejected above the hp threshold and kills a low-hp target for 4x damage", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.level = 12
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0

				// boar hp=30, well above execute's 25% threshold (7.5) at full
				// health — rejected outright, no damage, no cooldown consumed.
				variables.monsterService.handleUseSkill( variables.playerId, "execute", monsterId )
				expect( m.hp ).toBe( 30 )
				expect( p.skillCooldowns[ "execute" ] ?: 0 ).toBe( 0 )

				m.hp = 5 // below the 25% threshold
				variables.monsterService.handleUseSkill( variables.playerId, "execute", monsterId )
				expect( m.hp ).toBe( 0 )
				expect( m.alive ).toBeFalse()
			} )

			it( "handleUseSkill rampage needs no target and boosts a subsequent attack's damage", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.level = 20
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0
				var atk = p.attackDamage

				variables.monsterService.handleUseSkill( variables.playerId, "rampage", "" )
				var hpBeforeHit = m.hp
				variables.monsterService.handleAttack( variables.playerId, monsterId )

				expect( hpBeforeHit - m.hp ).toBe( atk * 1.5 )
			} )

			it( "each skill's cooldown is independent — using one doesn't block a different one", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.level = 5
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0

				variables.monsterService.handleUseSkill( variables.playerId, "heroicStrike", monsterId )
				var hpAfterFirst = m.hp

				// Still on its own cooldown — a second immediate cast no-ops.
				variables.monsterService.handleUseSkill( variables.playerId, "heroicStrike", monsterId )
				expect( m.hp ).toBe( hpAfterFirst )

				// A different skill has its own independent cooldown, unaffected.
				variables.monsterService.handleUseSkill( variables.playerId, "cleave", monsterId )
				expect( m.hp ).toBeLT( hpAfterFirst )
			} )

			it( "kills of Highlands monsters eventually yield a rare item, independent of the common-item roll", function() {
				variables.monsterService.spawnMonster( "alphaBoar", variables.gameConfig.getZones()[ 2 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				var p = variables.playerService.getPlayers()[ variables.playerId ]
				p.x = m.x
				p.z = m.z - 1
				p.rotationY = 0
				// Set base, not effective, attackDamage — a kill calls grantXp(),
				// which recomputes p.attackDamage from baseAttackDamage right
				// after the first kill, silently undoing a one-time override of
				// the effective value and leaving every later trial too weak to
				// one-shot (this bit the first version of this test). Recompute
				// once up front too, so the very first trial is already strong
				// enough rather than only from the second kill onward.
				p.baseAttackDamage = 1000
				variables.playerService.recomputeEffectiveStats( variables.playerId )

				// alphaBoar rolls apple(40%)/steelSword(12%)/ironHelmet(12%)
				// independently per kill — 200 trials makes "never got a rare"
				// astronomically unlikely (≈0.88^200) without being a fixed,
				// deterministic wait.
				for ( var i = 1; i <= 200; i++ ) {
					m.alive = true
					m.hp = m.maxHp
					p.attackReadyAt = 0
					variables.monsterService.handleAttack( variables.playerId, monsterId )
				}

				var gotRare = variables.inventoryService.hasItem( variables.characterId, "steelSword" )
					|| variables.inventoryService.hasItem( variables.characterId, "ironHelmet" )
				expect( gotRare ).toBeTrue()

				// The drops aren't mutually exclusive — over 200 trials at
				// 40%/12%/12% independently, more than one distinct item key
				// should show up, proving each entry in the table is its own
				// roll rather than "pick exactly one drop per kill".
				expect( variables.inventoryService.list( variables.characterId ).len() ).toBeGT( 1 )
			} )

			it( "tickMonsterAI respawns a dead monster at its home position once its timer has passed", function() {
				variables.monsterService.spawnMonster( "boar", variables.gameConfig.getZones()[ 1 ] )
				var monsters = variables.monsterService.getMonsters()
				var monsterId = structKeyList( monsters )
				var m = monsters[ monsterId ]
				m.alive = false
				m.hp = 0
				m.respawnAt = 0 // already due

				variables.monsterService.tickMonsterAI()

				expect( m.alive ).toBeTrue()
				expect( m.hp ).toBe( m.maxHp )
				expect( m.x ).toBe( m.homeX )
				expect( m.z ).toBe( m.homeZ )
			} )

		} )
	}

}
