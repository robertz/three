/**
 * GameConfig is pure static data + one-time-generated world layout, no DB
 * access — no beforeEach/afterEach cleanup needed anywhere in this spec.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "GameConfig", function() {

			it( "exposes all sixteen monster types (two per zone, 8 zones) with the fields combat/AI code depends on", function() {
				var gameConfig = new game.GameConfig()
				var monsterTypes = gameConfig.getMonsterTypes()

				expect( monsterTypes ).toHaveKey( "boar" )
				expect( monsterTypes ).toHaveKey( "wolf" )
				expect( monsterTypes ).toHaveKey( "alphaBoar" )
				expect( monsterTypes ).toHaveKey( "direWolf" )
				expect( structCount( monsterTypes ) ).toBe( 16 )

				expect( monsterTypes.boar.aggressive ).toBeFalse()
				expect( monsterTypes.wolf.aggressive ).toBeTrue()
				expect( monsterTypes.boar.hp ).toBeGT( 0 )
				expect( monsterTypes.boar.respawnDelay ).toBeGT( 0 )
			} )

			it( "gives every skill type the fields combat code depends on, unlocked in non-decreasing level order", function() {
				var gameConfig = new game.GameConfig()
				var skillTypes = gameConfig.getSkillTypes()

				expect( skillTypes ).toHaveKey( "heroicStrike" )
				expect( skillTypes ).toHaveKey( "cleave" )
				expect( skillTypes ).toHaveKey( "execute" )
				expect( skillTypes ).toHaveKey( "rampage" )

				// Plain struct literals don't guarantee enumeration order in
				// BoxLang, so the "unlocked in non-decreasing level order"
				// check walks this explicit, intended order rather than
				// relying on however skillTypes happens to iterate.
				var orderedIds = [ "heroicStrike", "cleave", "execute", "rampage" ]
				var lastLevel = 0
				for ( var id in orderedIds ) {
					var skill = skillTypes[ id ]
					expect( skill ).toHaveKey( "name" )
					expect( skill ).toHaveKey( "levelRequired" )
					expect( skill ).toHaveKey( "cooldown" )
					expect( skill.levelRequired ).toBeGTE( lastLevel )
					expect( skill.cooldown ).toBeGT( 0 )
					lastLevel = skill.levelRequired
				}

				expect( skillTypes.heroicStrike.levelRequired ).toBe( 1 )
				expect( skillTypes.execute.executeThreshold ).toBeGT( 0 )
				expect( skillTypes.rampage.buffMultiplier ).toBeGT( 1 )
				expect( skillTypes.rampage.buffDuration ).toBeGT( 0 )
			} )

			it( "lays out all 8 zones as contiguous, non-overlapping concentric bands", function() {
				var gameConfig = new game.GameConfig()
				var zones = gameConfig.getZones()

				expect( zones.len() ).toBe( 8 )
				expect( zones[ 1 ].key ).toBe( "meadow" )
				expect( zones[ 1 ].minRadius ).toBe( 0 )
				expect( zones[ 2 ].key ).toBe( "highlands" )

				// Every zone starts exactly where the previous one ends — no
				// gap, no overlap — since the whole world is one continuous
				// space, just 8 successively tougher bands of it.
				for ( var i = 2; i <= zones.len(); i++ ) {
					expect( zones[ i ].minRadius ).toBe( zones[ i - 1 ].maxRadius )
					expect( zones[ i ].maxRadius ).toBeGT( zones[ i ].minRadius )
				}
			} )

			it( "gives every item type the fields inventory/equip/shop code depends on", function() {
				var gameConfig = new game.GameConfig()
				var itemTypes = gameConfig.getItemTypes()

				expect( itemTypes.apple.usable ).toBeTrue()
				expect( itemTypes.apple.healAmount ).toBeGT( 0 )
				expect( itemTypes.ironSword.equipSlot ).toBe( "weapon" )
				expect( itemTypes.ironSword.bonusAttackDamage ).toBeGT( 0 )
				expect( itemTypes.ironSword.price ).toBeGT( 0 )

				// Every entry in every merchant's purchasable catalog must
				// reference a real item.
				for ( var npcId in gameConfig.getNpcs() ) {
					for ( var key in gameConfig.getNpcs()[ npcId ].shopCatalog ) {
						expect( itemTypes ).toHaveKey( key )
					}
				}
			} )

			it( "declares exactly the four equipment slots the client's Equipment panel renders", function() {
				var gameConfig = new game.GameConfig()
				expect( gameConfig.getEquipSlots() ).toBe( [ "weapon", "helmet", "chest", "trinket" ] )
			} )

			it( "gives every item type a rarity, and every equip slot a matching common + rare pair", function() {
				var gameConfig = new game.GameConfig()
				var itemTypes = gameConfig.getItemTypes()

				for ( var key in itemTypes ) {
					expect( itemTypes[ key ] ).toHaveKey( "rarity" )
					expect( [ "common", "rare" ] ).toInclude( itemTypes[ key ].rarity )
				}

				var rareBySlot = {}
				for ( var key in itemTypes ) {
					if ( itemTypes[ key ].rarity == "rare" ) {
						rareBySlot[ itemTypes[ key ].equipSlot ] = key
					}
				}
				for ( var slot in gameConfig.getEquipSlots() ) {
					expect( rareBySlot ).toHaveKey( slot )
				}
			} )

			it( "gives every item type a positive sell price, even ones that can't be bought", function() {
				var gameConfig = new game.GameConfig()
				var itemTypes = gameConfig.getItemTypes()

				for ( var key in itemTypes ) {
					expect( itemTypes[ key ] ).toHaveKey( "sellPrice" )
					expect( itemTypes[ key ].sellPrice ).toBeGT( 0 )
				}
			} )

			it( "never lists a rare item in any merchant's purchasable shop catalog", function() {
				var gameConfig = new game.GameConfig()
				var itemTypes = gameConfig.getItemTypes()

				for ( var npcId in gameConfig.getNpcs() ) {
					for ( var key in gameConfig.getNpcs()[ npcId ].shopCatalog ) {
						expect( itemTypes[ key ].rarity ).toBe( "common" )
					}
				}
			} )

			it( "gives every monster type a non-empty drop table referencing real items", function() {
				var gameConfig = new game.GameConfig()
				var itemTypes = gameConfig.getItemTypes()
				var monsterTypes = gameConfig.getMonsterTypes()

				for ( var typeKey in monsterTypes ) {
					var drops = monsterTypes[ typeKey ].drops
					expect( drops.len() ).toBeGT( 0 )
					for ( var drop in drops ) {
						expect( itemTypes ).toHaveKey( drop.item )
						expect( drop.chance ).toBeGT( 0 )
						expect( drop.chance ).toBeLTE( 1 )
					}
				}
			} )

			it( "gives every zone past the Meadow a shot at a rare item the Meadow monsters can never drop", function() {
				var gameConfig = new game.GameConfig()
				var monsterTypes = gameConfig.getMonsterTypes()
				var itemTypes = gameConfig.getItemTypes()

				var hasRareDrop = function( typeKey ) {
					for ( var drop in monsterTypes[ typeKey ].drops ) {
						if ( itemTypes[ drop.item ].rarity == "rare" ) {
							return true
						}
					}
					return false
				}

				expect( hasRareDrop( "boar" ) ).toBeFalse()
				expect( hasRareDrop( "wolf" ) ).toBeFalse()

				var zones = gameConfig.getZones()
				for ( var i = 2; i <= zones.len(); i++ ) {
					for ( var typeKey in zones[ i ].spawns ) {
						expect( hasRareDrop( typeKey ) ).toBeTrue()
					}
				}
			} )

			it( "formats all 8 merchant NPCs into the wire shape npcSnapshot() sends to clients, each with its own catalog", function() {
				var gameConfig = new game.GameConfig()
				var snapshot = gameConfig.npcSnapshot()

				expect( snapshot.len() ).toBe( 8 )

				var shopkeeper1 = snapshot.filter( ( n ) => n.id == "shopkeeper1" )
				expect( shopkeeper1.len() ).toBe( 1 )

				for ( var n in snapshot ) {
					expect( n ).toHaveKey( "x" )
					expect( n ).toHaveKey( "z" )
					expect( n ).toHaveKey( "model" )
					expect( n.catalog.len() ).toBeGT( 0 )
					for ( var item in n.catalog ) {
						expect( item ).toHaveKey( "price" )
						expect( item ).toHaveKey( "rarity" )
					}
				}
			} )

			it( "formats zones into the wire shape zoneSnapshot() sends to clients, without leaking spawn tables", function() {
				var gameConfig = new game.GameConfig()
				var snapshot = gameConfig.zoneSnapshot()

				expect( snapshot.len() ).toBe( 8 )
				expect( snapshot[ 1 ] ).notToHaveKey( "spawns" )
				expect( snapshot[ 1 ] ).toHaveKey( "groundTint" )
			} )

			it( "generates the expected number of props and mountains, each with a full position/rotation", function() {
				var gameConfig = new game.GameConfig()
				var props = gameConfig.getProps()
				var mountains = gameConfig.getMountains()

				expect( props.len() ).toBe( 320 )
				expect( mountains.len() ).toBe( 84 )

				for ( var prop in props ) {
					expect( prop ).toHaveKey( "type" )
					expect( prop ).toHaveKey( "x" )
					expect( prop ).toHaveKey( "z" )
					expect( prop ).toHaveKey( "rotationY" )
				}
				for ( var mountain in mountains ) {
					expect( mountain ).toHaveKey( "scale" )
					expect( mountain.scale ).toBeGT( 0 )
				}
			} )

			it( "rolls a different world layout for each new instance (it's per-process, not hardcoded)", function() {
				var first = new game.GameConfig()
				var second = new game.GameConfig()

				// Vanishingly unlikely to collide by chance across 320
				// independently randomized props — a match here would mean
				// the "random" layout is actually a fixed constant,
				// defeating the point of rolling it at startup at all.
				expect( JSONSerialize( first.getProps() ) ).notToBe( JSONSerialize( second.getProps() ) )
			} )

		} )
	}

}
